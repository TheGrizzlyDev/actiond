load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":stress.bzl", "stress_workload")

filegroup(
    name = "bare_inputs",
    srcs = glob(["bare/*.txt"]),
)

filegroup(
    name = "nested_individual_inputs",
    srcs = glob(["nested_files/**/*.txt"]),
)

filegroup(
    name = "source_tree_inputs",
    srcs = glob(
        ["source_dir/pkg_*"],
        exclude_directories = 0,
    ),
)

stress_workload(
    name = "stress_all",
    tool = "//tool:action-tool",
)

sh_test(
    name = "parse_timings_test",
    srcs = ["parse_timings_test.sh"],
    data = ["parse_timings.py"],
)

# Runtime and resource requirements travel with the execution platform.
[platform(
    name = "linux_" + cpu,
    constraint_values = ["@platforms//cpu:" + cpu, "@platforms//os:linux"],
    exec_properties = {
        "libc": "glibc2.35",
        "requires-bash": "",
        "limits.memory.bytes": "536870912",
        "limits.cpu.cores": "2",
        "limits.pids.max": "128",
    },
) for cpu in ["aarch64", "x86_64"]]

[platform(
    name = "linux_" + cpu + "_pids_one",
    parents = [":linux_" + cpu],
    exec_properties = {"limits.pids.max": "1"},
) for cpu in ["aarch64", "x86_64"]]
