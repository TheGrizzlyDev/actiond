+def _uncovered_inputs(files, paths):
+    result = []
+    for file in files:
+        parts = file.path.split("/")
+        if not any(["/".join(parts[:i]) in paths for i in range(1, len(parts) + 1)]):
+            result.append(file)
+    return result
+
+def _nonoverlapping_inputs(files):
+    # Keep lookup files in the provider, but omit children of directory inputs
+    # from action sandboxes. Normalize the large shared source set only once.
+    paths = {file.path: True for file in files}
+    result = []
+    for file in files:
+        parts = file.path.split("/")
+        if not any(["/".join(parts[:i]) in paths for i in range(1, len(parts))]):
+            result.append(file)
+    return result
